# ==============================================================================
# SOFTCARE HOSPITAL OS — ENVIRONMENT CONFIGURATION TEMPLATE
# ==============================================================================
# Instructions:
# 1. Copier ce fichier sous le nom .env : cp .env.example .env
# 2. Renseigner les secrets forts et uniques pour votre environnement.
# 3. Ne JAMAIS commiter le fichier .env dans le dépôt Git (déjà ignoré).
# ==============================================================================

# --- BASE DE DONNÉES POSTGRESQL ---
POSTGRES_DB=softcare_db
POSTGRES_USER=postgres
POSTGRES_PASSWORD=CHANGE_ME_IN_PRODUCTION_SECURE_PASSWORD_123!
POSTGRES_PORT=5432

# --- SÉCURITÉ JWT ---
# Doit comporter au minimum 64 caractères pour HS256 / production
JWT_SECRET=CHANGE_ME_SUPER_SECRET_KEY_FOR_JWT_ENCRYPTION_MIN_64_CHARS_2026!#
JWT_ISSUER=SoftCareAPI
JWT_AUDIENCE=SoftCareClients
JWT_EXPIRY_DAYS=7

# --- PGADMIN ---
PGADMIN_DEFAULT_EMAIL=admin@softcare.fr
PGADMIN_DEFAULT_PASSWORD=CHANGE_ME_PGADMIN_PASSWORD_2026!
PGADMIN_PORT=5050

# --- PORTS & ENVIRONNEMENT ---
BACKEND_PORT=5000
FRONTEND_PORT=3000
ASPNETCORE_ENVIRONMENT=Production

# --- FRONTEND CLIENT ---
VITE_API_URL=http://localhost:5291/api
